# Example environment configuration for One-Time Text Bridge.
# Copy to .env and fill in real values. Never commit a real .env file.

# development or production
ENVIRONMENT=development

# SQLite database path (relative to the app working directory)
DATABASE_URL=sqlite:///./data/app.db

# Used to sign CSRF tokens. MUST be a long random value in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Comma-separated list of hostnames this app is allowed to serve (TrustedHostMiddleware)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of IP addresses trusted to set X-Forwarded-* headers.
# For IIS running on this same Windows host, use 127.0.0.1.
TRUSTED_PROXY_IPS=127.0.0.1

# Public base URL used to build receive links and QR codes, e.g. https://example.com
BASE_URL=http://localhost:8000

# Maximum stored message length in characters
MAX_MESSAGE_LENGTH=2000

# Maximum size for one uploaded file or photo, in bytes (10 MiB)
MAX_UPLOAD_BYTES=10485760

# How often (seconds) the background cleanup task removes expired/consumed messages
CLEANUP_INTERVAL_SECONDS=60

# Simple in-memory per-IP rate limit (requests per minute) - dev/single-instance only
RATE_LIMIT_PER_MINUTE=20

# Optional: an additional shared passphrase layer (disabled if unset).
# See README "Optional hardening" for how this could be wired in, or use an
# identity-aware proxy (Cloudflare Access, Tailscale) in front of this app instead.
SHARED_PASSPHRASE=
