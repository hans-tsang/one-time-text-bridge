# Local development proxy. Replace with your real domain for production;
# Caddy will then automatically obtain and renew a Let's Encrypt certificate.
http://localhost {
    encode gzip

    reverse_proxy app:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Host {host}
    }
}
